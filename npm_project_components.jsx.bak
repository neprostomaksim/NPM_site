/* ═══ HOOKS ═══ */
function useScrollReveal(threshold) {
  const ref = React.useRef(null);
  const [visible, setVisible] = React.useState(false);
  React.useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const obs = new IntersectionObserver(
      ([e]) => { if (e.isIntersecting) { setVisible(true); obs.disconnect(); } },
      { threshold: threshold || 0.12 }
    );
    obs.observe(el);
    return () => obs.disconnect();
  }, []);
  return [ref, visible];
}

function useCountUp(target, active, duration) {
  const dur = duration || 2000;
  const [val, setVal] = React.useState(0);
  React.useEffect(() => {
    if (!active) return;
    let start = null;
    const step = function (ts) {
      if (!start) start = ts;
      var p = Math.min((ts - start) / dur, 1);
      var eased = 1 - Math.pow(1 - p, 3);
      setVal(Math.floor(eased * target));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }, [active, target, dur]);
  return val;
}

function smoothScrollTo(id) {
  var el = document.getElementById(id);
  if (el) {
    var top = el.getBoundingClientRect().top + window.scrollY - 72;
    window.scrollTo({ top: top, behavior: 'smooth' });
  }
}

/* ═══ NAV ═══ */
function Nav() {
  const [scrolled, setScrolled] = React.useState(false);
  const [menuOpen, setMenuOpen] = React.useState(false);

  React.useEffect(() => {
    var onScroll = function () { setScrolled(window.scrollY > 50); };
    window.addEventListener('scroll', onScroll, { passive: true });
    return function () { window.removeEventListener('scroll', onScroll); };
  }, []);

  React.useEffect(() => {
    document.body.style.overflow = menuOpen ? 'hidden' : '';
    return function () { document.body.style.overflow = ''; };
  }, [menuOpen]);

  var handleClick = function (e, id) {
    e.preventDefault();
    setMenuOpen(false);
    smoothScrollTo(id);
  };

  return React.createElement(React.Fragment, null,
    React.createElement('nav', { className: 'nav' + (scrolled ? ' scrolled' : '') },
      React.createElement('a', { href: '#', className: 'nav-brand', onClick: function(e){ e.preventDefault(); window.scrollTo({top:0,behavior:'smooth'}); } }, 'МАКСИМ ЛЕОНОВ'),
      React.createElement('div', { className: 'nav-center' },
        React.createElement('a', { href: '#about', onClick: function(e){ handleClick(e,'about'); } }, 'Обо мне'),
        React.createElement('a', { href: '#services', onClick: function(e){ handleClick(e,'services'); } }, 'Услуги'),
        React.createElement('a', { href: '#blog', onClick: function(e){ handleClick(e,'blog'); } }, 'Блог')
      ),
      React.createElement('div', { className: 'nav-cta' },
        React.createElement('a', { href: '#cta', className: 'btn btn-primary', onClick: function(e){ handleClick(e,'cta'); } }, 'Записаться')
      ),
      React.createElement('button', { className: 'hamburger', onClick: function(){ setMenuOpen(true); }, 'aria-label': 'Меню' },
        React.createElement('span'), React.createElement('span'), React.createElement('span')
      )
    ),
    React.createElement('div', { className: 'mobile-menu' + (menuOpen ? ' open' : '') },
      React.createElement('button', { className: 'close-btn', onClick: function(){ setMenuOpen(false); } }, '×'),
      React.createElement('a', { href: '#about', onClick: function(e){ handleClick(e,'about'); } }, 'Обо мне'),
      React.createElement('a', { href: '#services', onClick: function(e){ handleClick(e,'services'); } }, 'Услуги'),
      React.createElement('a', { href: '#blog', onClick: function(e){ handleClick(e,'blog'); } }, 'Блог'),
      React.createElement('a', { href: '#cta', className: 'btn btn-primary', onClick: function(e){ handleClick(e,'cta'); } }, 'Записаться')
    )
  );
}

