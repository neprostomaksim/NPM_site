/* ═══ MARQUEE ═══ */
function MarqueeTicker() {
  var items = ['НЕЙРОСЕТИ', 'АВТОМАТИЗАЦИЯ', 'ПРОМПТИНГ', 'CHATGPT', 'CLAUDE', 'MIDJOURNEY', 'СТРАТЕГИЯ', 'ОБУЧЕНИЕ', 'БИЗНЕС', 'AI-АГЕНТЫ'];
  var content = items.map(function(item, i) {
    return React.createElement(React.Fragment, { key: i },
      React.createElement('span', null, item),
      React.createElement('div', { className: 'marquee-dot' })
    );
  });
  return React.createElement('div', { className: 'marquee' },
    React.createElement('div', { className: 'marquee-track' },
      React.createElement('div', { className: 'marquee-content' }, content),
      React.createElement('div', { className: 'marquee-content', 'aria-hidden': 'true' }, content)
    )
  );
}

/* ═══ STAT ITEM ═══ */
function StatItem(props) {
  var stat = props.stat;
  var count = useCountUp(stat.target, props.visible, 2200);
  var formatted = stat.target >= 1000
    ? new Intl.NumberFormat('ru-RU').format(count).replace(/\u00a0/g, ' ').replace(/\s/g, ' ')
    : count.toString();

  return React.createElement('div', {
    className: 'stat-item reveal-up' + (props.visible ? ' visible' : ''),
    style: { transitionDelay: props.delay + 'ms' }
  },
    React.createElement('div', { className: 'stat-number' },
      formatted,
      React.createElement('span', { className: 'stat-plus' }, stat.suffix)
    ),
    React.createElement('div', { className: 'stat-label' }, stat.label)
  );
}

/* ═══ NUMBERS ═══ */
function Numbers() {
  var ref_vis = useScrollReveal(0.25);
  var ref = ref_vis[0], visible = ref_vis[1];
  var stats = [
    { target: 27600, suffix: '+', label: 'подписчиков в Instagram' },
    { target: 300, suffix: '+', label: 'учеников уже используют ИИ в работе' },
    { target: 2500, suffix: '+', label: 'участников сообщества M.AI.N' }
  ];
  return React.createElement('section', { className: 'numbers', ref: ref },
    React.createElement('div', { className: 'container' },
      React.createElement('div', { className: 'stats-grid' },
        stats.map(function(s, i) {
          return React.createElement(StatItem, { key: i, stat: s, visible: visible, delay: i * 180 });
        })
      )
    )
  );
}

